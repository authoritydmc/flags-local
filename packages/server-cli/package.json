  "bin": {
    "flags-local": "./bin/flags-local.js"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "launchdarkly-alternative",
    "unleash-alternative",
    "flagsmith-alternative",
    "feature-management",
